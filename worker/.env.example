# Worker environment — copy to .env (local) or set in the host's dashboard.

# Supabase / Postgres (same project the app + ledger use)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR-SERVICE-ROLE-KEY

# Email delivery (Resend)
RESEND_API_KEY=re_xxx
RESEND_FROM=Palma Property Intelligence <reports@palma.llc>

# Optional tuning
POLL_INTERVAL_MS=5000      # how often to check the queue when idle
SCRAPE_TIMEOUT_MS=240000   # hard cap per job (4 min)
HEADLESS=true              # set false locally to watch the browser during calibration
